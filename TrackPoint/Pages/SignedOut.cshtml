@page "/SignedOut"
@{
    Layout = null;
    ViewData["Title"] = "Signed Out";
}

<!DOCTYPE html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Signed Out - TrackPoint</title>
    <link rel="stylesheet" href="/css/form.css" />
</head>
<body>
    <div class="page">
        <div class="card" style="text-align: center;">
            <div style="font-size: 48px; margin-bottom: 12px;">✅</div>

            <h1 style="text-align: center; margin-bottom: 12px;">You have signed out</h1>

            <p class="text-muted mb-4" style="text-align: center; margin-bottom: 24px; color: #6b7280;">
                Your session has ended successfully.
            </p>

            <a href="/MicrosoftIdentity/Account/SignIn?redirectUri=/"
               class="primary-btn"
               style="display: block; width: fit-content; margin: 0 auto; text-decoration: none;">
                Sign in again
            </a>
        </div>
    </div>
</body>