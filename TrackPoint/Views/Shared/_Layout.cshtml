<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TrackPoint</title>

    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/TrackPoint.styles.css" />

    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />

    <!-- Fonts + Icons -->
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
            body {
                font-family: 'DM Sans', sans-serif;
                background: #f8fafc;
            }
            /* ===== Top Navbar ===== */
            .topbar {
                height: 64px;
                background: #064973;
                border-bottom: 1px solid #e2e8f0;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 24px;
                position: sticky;
                top: 0;
                z-index: 900;
            }

            .topbar-title {
                font-size: 20px;
                font-weight: 600;
                color: #ffffff;
            }

            .topbar-actions {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .topbar-icon {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: #f1f5f9;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #475569;
                cursor: pointer;
                transition: all 0.2s ease;
            }

                .topbar-icon:hover {
                    background: #e2e8f0;
                    transform: translateY(-1px);
                }

            /* ===== Sidebar ===== */
            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                width: 220px;
                height: 100vh;
                background: #064973;
                padding: 20px 14px;
                display: flex;
                flex-direction: column;
            }

            .main-with-sidebar {
                margin-left: 220px;
                min-height: 100vh;
            }

            /* Logo */
            .sidebar .navbar-brand {
                margin-bottom: 20px;
            }

            /* Section labels */
            .sidebar-section {
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: .08em;
                color: #94a3b8;
                margin-bottom: 6px;
            }

            /* Nav links */
            .sidebar .nav-link {
                border-radius: 10px;
                padding: 10px 12px;
                font-weight: 500;
                color: #e2e8f0;
                display: flex;
                align-items: center;
                gap: 10px;
                transition: all 0.2s ease;
            }

                .sidebar .nav-link i {
                    font-size: 15px;
                    transition: transform 0.2s ease;
                }

                /* Hover */
                .sidebar .nav-link:hover {
                    background: rgba(255,255,255,0.12);
                    color: #fff;
                    transform: translateX(3px);
                }

                    .sidebar .nav-link:hover i {
                        transform: scale(1.05);
                    }

                /* Active */
                .sidebar .nav-link.active {
                    background: rgba(255,255,255,0.18);
                    color: #fff;
                    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.05);
                }

            /* Bottom user section */
            .sidebar-footer {
                margin-top: auto;
                padding-top: 20px;
            }

            /* Content */
            /* main {
                padding: 24px;
            } */

            footer {
                border-top: 1px solid #e2e8f0;
                padding: 16px 24px;
                font-size: 14px;
                color: #64748b;
            }
    </style>
</head>

<body>
    @{
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
    }

    @if (isAuthenticated)
    {
        <nav class="sidebar">

            <!-- Logo -->
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="https://www.lsnf.org/wp-content/themes/LSNFtheme/assets/images/Logo.png"
                     style="height:50px;" />
            </a>

            @{
                var isAdmin = User.IsInRole("Admin");
                var isBorrower = User.IsInRole("Borrower");
            }

            <!-- ===== Dashboard ===== -->
            <div class="sidebar-section">Dashboard</div>
            <ul class="nav flex-column mb-3">

                @if (isAdmin || isBorrower)
                {
                    <li>
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                               asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-clipboard-data-fill"></i> Borrower
                        </a>
                    </li>
                }

                @if (isAdmin)
                {
                    <li>
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "adminDashboard" ? "active" : "")"
                               asp-controller="Dashboard" asp-action="adminDashboard">
                            <i class="bi bi-shield-shaded"></i> Admin
                        </a>
                    </li>
                }
            </ul>

            <!-- ===== Assets ===== -->
            <div class="sidebar-section">Assets</div>
            <ul class="nav flex-column mb-3">

                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AssetBrowser" ? "active" : "")"
                           asp-controller="Asset" asp-action="AssetBrowser">
                        <i class="bi bi-basket-fill"></i> Browse Assets
                    </a>
                </li>

                @if (isAdmin)
                {
                    <li>
                        <a class="nav-link" asp-controller="Asset" asp-action="AssetAdd">
                            <i class="bi bi-plus-square-fill"></i> Register Asset
                        </a>
                    </li>

                    <li>
                        <a class="nav-link" asp-controller="Asset" asp-action="TransferLog">
                            <i class="bi bi-journal"></i> Transfer Log
                        </a>
                    </li>
                }
            </ul>

            @if (isAdmin)
            {
                <!-- ===== Management ===== -->
                <div class="sidebar-section">Management</div>
                <ul class="nav flex-column">

                    <li>
                        <a class="nav-link" asp-controller="Admin" asp-action="AllocateDemo">
                            <i class="bi bi-clipboard-plus"></i> Admin Allocation
                        </a>
                    </li>

                    <li>
                        <a class="nav-link" asp-controller="Asset" asp-action="ManageCategories">
                            <i class="bi bi-box-seam-fill"></i> Category
                        </a>
                    </li>

                    <li>
                        <a class="nav-link" asp-controller="Asset" asp-action="ManageLocations">
                            <i class="bi bi-building-fill"></i> Location
                        </a>
                    </li>

                </ul>
            }

            <!-- ===== Footer ===== -->
            <div class="sidebar-footer">
                <partial name="_LoginPartial" />
            </div>
        </nav>
    }

    <!-- ===== Main Content ===== -->
    <div class="@(isAuthenticated ? "main-with-sidebar d-flex flex-column" : "d-flex flex-column min-vh-100")">

        @if (isAuthenticated)
        {
            <!-- ===== Topbar ===== -->
            <div class="topbar">
                <div class="topbar-title">
                    @ViewData["Title"]
                </div>

                <div class="topbar-actions">
                    <div class="topbar-icon">
                        <i class="bi bi-bell"></i>
                    </div>

                    <div class="topbar-icon">
                        <i class="bi bi-chat-dots"></i>
                    </div>

                    <div class="topbar-icon">
                        <i class="bi bi-gear"></i>
                    </div>
                </div>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>

        <footer>
            © 2025 - TrackPoint -
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="~/js/site.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>