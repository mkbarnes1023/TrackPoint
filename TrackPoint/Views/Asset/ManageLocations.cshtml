@{
}
@model IEnumerable<TrackPoint.Models.Location>
<head>
    <link rel="stylesheet" href="/css/manager.css">
</head>
<style>
    .primary-btn {
        width: 25%;
        margin-top: 28px;
        padding: 14px;
        font-size: 15px;
        font-weight: 600;
        text-align: center;
        color: #fff;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: transform 0.15s, box-shadow 0.15s;
        text-decoration: none;
    }

        .primary-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(79, 70, 229, 0.35);
        }
</style>



<div class="page">
    <div class="card">
        <h1>Manage Locations</h1>
        <div style="text-align: center; padding: 15px;">
            <a asp-controller="Asset" asp-action="LocationAdd" class="primary-btn">
                Register Location
            </a>
        </div>
        <div class="overflow-auto">
            @*
        Display each location in a list with options
    *@
            <ul class="list-group">
                @foreach (Location l in Model)
                {
                    // Exclude the "Unasigned" location. It exists for edge cases and cannot be managed.
                    if (l.LocationId != 1)
                    {
                        string modalId = $"confirmModal-{l.LocationId}"; ;
                        <li class="list-group-item">
                            @l.Name (@l.Abbreviation) <a class="btn btn-sm" asp-controller="Asset" asp-action="LocationEdit" asp-route-locationId="@l.LocationId"><i class="bi bi-pencil-fill fs-4"></i></a> <a class="btn btn-sm" data-bs-toggle="modal" data-bs-target="#@modalId"><i class="bi bi-trash-fill fs-4"></i></a>
                            <!--Confirmation modal adapted from Matthew's in the AssetBrowser-->
                            <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@($"{modalId}-label")" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="@($"{modalId}-label")">Delete Location: @l.Name (@l.Abbreviation)</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            Are you sure you want to delete this location? <strong>All existing assets with this location will be reassigned to have no location.</strong>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <a asp-controller="Asset" asp-action="DeleteLocation" asp-route-locationId="@l.LocationId" class="btn btn-sm"><i class="bi bi-trash-fill fs-4"></i></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
</div>