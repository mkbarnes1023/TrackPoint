@model TrackPoint.Models.Office
@{
    ViewData["Title"] = "Add Office";
}

@if(TempData["InputError"] != null)
{
	<div class="alert alert-danger" role="alert">
		@TempData["InputError"]
	</div>
}

<head>
	<link rel="stylesheet" href="/css/form.css">
</head>
<div class="page">
	<div class="card">
		<h1 style="margin-bottom: 0px !important;">Register an Office</h1> @* TODO: Add location name *@

		<form asp-action="NewOffice" asp-route-locationId="@ViewBag.LocationId" method="post">
			<input type="hidden" asp-for="OfficeId">
            <input type="hidden" name="locationId" value="@ViewBag.LocationId" />
			<div class="section">
                <div>
                    <label asp-for="Name">Name</label>
                    <input type="text" asp-for="Name" value="@Model.Name" required>
                </div>
            </div>
			<input type="submit" value="Submit" class="primary-btn">
		</form>
	</div>
</div>

