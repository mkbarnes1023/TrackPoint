@model TrackPoint.Models.Location;
@{
}

@if(TempData["InputError"] != null)
{
	<div class="alert alert-danger" role="alert">
		@TempData["InputError"]
	</div>
}

<head>
	<link rel="stylesheet" href="/css/form.css">
</head>

<div class="page">
	<div class="card">
		<h1>Register a Location</h1>

		<form>
			<input type="hidden" asp-for="LocationId">
			<div class="section">
                <div>
                    <label asp-for="Name">Name</label>
                    <input type="text" asp-for="Name" value="@Model.Name" required>
                </div>

                <div>
                    <label asp-for="Abbreviation">Abbreviation</label>
                    <input type="text" asp-for="Abbreviation" value="@Model.Abbreviation" required maxlength="10">
                </div>

            </div>
			<input type="submit" value="Submit" asp-action="NewLocation" class="primary-btn">
		</form>
	</div>
</div>

