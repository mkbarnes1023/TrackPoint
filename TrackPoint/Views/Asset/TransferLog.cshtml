@using Microsoft.AspNetCore.Identity
@model IEnumerable<TrackPoint.Models.TransferLog>
@inject UserManager<IdentityUser> UserManager
@{
        ViewData["Title"] = "Transfer Log";
}
<head>
    <link rel="stylesheet" href="/css/table.css">
</head>


<div class="page">
        
        <div class="card">
        <h1>Transfer Log</h1>

        <style>
            /* Loading overlay used across asset pages */
            #page-loading-overlay {
                position: fixed; inset: 0; background: rgba(255,255,255,0.95); z-index: 2000;
                display:flex; align-items:center; justify-content:center; flex-direction:column;
                transition: opacity 0.35s ease;
            }
            .loader { width:48px; height:48px; border-radius:50%; border:6px solid #eef2ff; border-top-color:#6b46c1; animation: spin 1s linear infinite; margin-bottom:10px; }
            @@keyframes spin { to { transform: rotate(360deg); } }
            #page-loading-text { color:#374151; font-weight:500; font-size:14px; }
        </style>
        <div id="page-loading-overlay" aria-hidden="true">
            <div class="loader" role="status" aria-hidden="true"></div>
            <div id="page-loading-text">Loading&hellip;</div>
        </div>

        <table class="table w-100" id="table" style="display:none;">
            <thead>
                <tr>
                    <th>ID</th>
                    <th></th> <!-- Divider -->
                    <th>Asset Tag</th>
                    <th>Make & Model</th>
                    <th></th> <!-- Divider -->
                    <th>Transfer Type</th>
                    <th>Transfer Details</th>
                    <th>Date</th>
                </tr>
            </thead>
                <tbody>
                    @foreach (var tLogEntry in Model)
                    {
                        <tr>
                            <td>@tLogEntry.TransferLogId</td>
                            <td>·</td>
                            <td>@tLogEntry.Asset.AssetTag</td>
                            <td>@tLogEntry.Asset.Make @tLogEntry.Asset.Model</td>
                            <td>·</td>
                            @switch (tLogEntry.eventType)
                            {
                                case Enums.eventType.Creation:
                                    <td>Asset Creation</td>
                                    <td>Asset @tLogEntry.Asset.AssetTag created</td>
                                    break;
                                case Enums.eventType.BorrowerTransfer:
                                    @if (tLogEntry.OldBorrowerId == null) @* Check Out *@
                                    {
                                        <td>Check Out</td>
                                        <td>Storage -> @UserManager.FindByIdAsync(tLogEntry.NewBorrowerId).GetAwaiter().GetResult()</td>
                                    }
                                    else if (tLogEntry.NewBorrowerId == null) @* Check In *@
                                    {
                                        <td>Check In</td>
                                        <td>@UserManager.FindByIdAsync(tLogEntry.OldBorrowerId).GetAwaiter().GetResult() -> Storage</td>
                                    }
                                    else @* Borrower Transfer *@
                                    {
                                        <td>Borrower Transfer</td>
                                        <td>@UserManager.FindByIdAsync(tLogEntry.OldBorrowerId).GetAwaiter().GetResult() -> @UserManager.FindByIdAsync(tLogEntry.NewBorrowerId).GetAwaiter().GetResult()</td>
                                    }
                                    break;
                                case Enums.eventType.StatusChange:
                                    <td>Status Change</td>
                                    <td>@tLogEntry.OldStatus -> @tLogEntry.NewStatus</td>
                                    break;
                                default:
                                    <td>Unhandled Case</td>
                                    <td></td> @* TODO: Finish the other cases so they don't redirect here *@
                                    break;
                            }
                            <td>@tLogEntry.TransferDate.ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        

        </div>
</div>

<!-- DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script>
    // Wait for full page load to avoid layout shift, then initialize DataTables
    $(window).on('load', function () {
        $('#table').DataTable({
            autoWidth: false,
            "order": [[ 7, "desc" ]],
            "columnDefs":
            [
                {
                    "orderable": false, "targets": [1, 4, 6],
                    "searchable": false, "targets": [1, 4]
                }
            ],
            initComplete: function () {
                try { this.api().columns.adjust(); } catch (e) { console.warn('columns.adjust failed', e); }
                try { $('#page-loading-overlay').fadeOut(350); } catch (e) { }
                try { $('#table').fadeIn(300); } catch (e) { $('#table').css('display', ''); }
            }
        });
    });
</script>
