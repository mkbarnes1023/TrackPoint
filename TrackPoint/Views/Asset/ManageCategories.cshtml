@{
    ViewData["Title"] = "Category";
}
@model IEnumerable<TrackPoint.Models.Category>
<link rel="stylesheet" href="/css/manager.css">
<style>
    .primary-btn {
        width: 25%;
        margin-top: 28px;
        padding: 14px;
        font-size: 15px;
        font-weight: 600;
        text-align: center;
        color: #fff;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: transform 0.15s, box-shadow 0.15s;
        text-decoration: none;
    }

        .primary-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(79, 70, 229, 0.35);
        }
</style>


<div class="page">
    <div class="card">
        <h1>Manage Categories</h1>
        <div style="text-align: center; padding: 15px;">
            <a asp-controller="Asset" asp-action="CategoryAdd" class="primary-btn">
                Register Category
            </a>
        </div>
        <div class="section">
            @*
        Display each category in a list with options
    *@
            <ul class="list-group">
                @foreach (Category c in Model)
                {
                    // Exclude the "Unasigned" category. It exists for edge cases and cannot be managed.
                    if (c.CategoryId != 1)
                    {
                        string modalId = $"confirmModal-{c.CategoryId}"; ;
                        <li class="list-group-item" style="justify-content:space-between">
                            
                            @c.Name (@c.Abbreviation) <a class="btn btn-sm" asp-controller="Asset" asp-action="CategoryEdit" asp-route-categoryId="@c.CategoryId"><i class="bi bi-pencil-fill fs-4"></i></a> <a class="btn btn-sm" data-bs-toggle="modal" data-bs-target="#@modalId"><i class="bi bi-trash-fill fs-4"></i></a>
                            <!--Confirmation modal adapted from Matthew's in the AssetBrowser-->
                            <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@($"{modalId}-label")" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="@($"{modalId}-label")">Delete Category: @c.Name (@c.Abbreviation)</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            Are you sure you want to delete this category? <strong>All existing assets in this category will be reassigned to have no category.</strong>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <a asp-controller="Asset" asp-action="DeleteCategory" asp-route-categoryId="@c.CategoryId" class="btn btn-danger">Delete</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
</div>

