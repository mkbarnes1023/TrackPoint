@model TrackPoint.Views.Asset.CategoryEditViewModel;
@{
}

@if(TempData["InputError"] != null)
{
	<div class="alert alert-danger" role="alert">
		@TempData["InputError"]
	</div>
}
<head>
    <link rel="stylesheet" href="/css/form.css">
</head>

<div class="page">
    <div class="card">
        <h1>Editing a Category</h1>
        <div class="section">
            <!-- Make sure the category exists before populating the form. This is to prevent errors by using the browser's back button -->
            @if (Model.category == null)
            {
                <h1>The category you wish to edit no longer exists</h1>
                <a class="btn btn-primary" asp-controller="Asset" asp-action="ManageCategories">Return to categroy list</a>
            }
            else
            {
                <form>
                    <input type="hidden" asp-for="category.CategoryId">
                    <div>
                        <label asp-for="category.Name">Name</label>
                        <input type="text" asp-for="category.Name" value="@Model.category.Name" required>
                    </div>

                    <div>
                        <label asp-for="category.Abbreviation">Abbreviation</label>
                        <input type="text" asp-for="category.Abbreviation" value="@Model.category.Abbreviation" required maxlength="10">
                    </div>

                    <div>
                        <label asp-for="category.Description">Description</label>
                        <textarea asp-for="category.Description" placeholder="Description">@Model.category.Description</textarea>
                    </div>

                    <div class="toggle-row">
                        <label asp-for="category.RequiresApproval">This category requires approval to check out</label>
                        <label class="switch">
                            @if (Model.category.RequiresApproval)
                            {
                                <input type="checkbox" asp-for="category.RequiresApproval" checked>
                                <span class="slider"></span>
                            }
                            else
                            {
                                <input type="checkbox" asp-for="category.RequiresApproval">
                                <span class="slider"></span>
                            }
                        </label>

                    </div>

                    <div>
                        <label asp-for="category.DefaultLoanPeriodDays">Default loan period (In days)</label>
                        <input type="number" asp-for="category.DefaultLoanPeriodDays" value="@Model.category.DefaultLoanPeriodDays" min="0">
                    </div>

                    <div>
                        <label asp-for="category.Icon">Icon</label>
                        <div style="display:flex;">
                            <select asp-for="category.Icon" class="form-select" placeholder="Icon" onchange="document.getElementById('iconPreview').innerHTML='<i class=\'bi '+this.value+'\'></i>'">
                                <option value="bi-question-circle" selected="@(Model.category.Icon == "bi-question-circle" ? "selected" : null)">Unassigned</option>
                                <option value="bi-laptop" selected="@(Model.category.Icon == "bi-laptop" ? "selected" : null)">Laptop</option>
                                <option value="bi-display" selected="@(Model.category.Icon == "bi-display" ? "selected" : null)">Monitor</option>
                                <option value="bi-tv" selected="@(Model.category.Icon == "bi-tv" ? "selected" : null)">Smart TV</option>
                                <option value="bi-phone" selected="@(Model.category.Icon == "bi-phone" ? "selected" : null)">Phone</option>
                                <option value="bi-speaker" selected="@(Model.category.Icon == "bi-speaker" ? "selected" : null)">Sound Bar</option>
                                <option value="bi-truck" selected="@(Model.category.Icon == "bi-truck" ? "selected" : null)">Vehicle</option>
                                <option value="bi-people" selected="@(Model.category.Icon == "bi-people" ? "selected" : null)">Outreach</option>
                                <option value="bi-boombox" selected="@(Model.category.Icon == "bi-boombox" ? "selected" : null)">AV System</option>
                                <option value="bi-printer" selected="@(Model.category.Icon == "bi-printer" ? "selected" : null)">Printer</option>
                                <option value="bi-usb-drive" selected="@(Model.category.Icon == "bi-usb-drive" ? "selected" : null)">USB Drive</option>
                                <option value="bi-hdd" selected="@(Model.category.Icon == "bi-hdd" ? "selected" : null)">Hard Drive</option>
                                <option value="bi-router" selected="@(Model.category.Icon == "bi-router" ? "selected" : null)">Router</option>
                                <option value="bi-camera" selected="@(Model.category.Icon == "bi-camera" ? "selected" : null)">Camera</option>
                                <option value="bi-lightbulb" selected="@(Model.category.Icon == "bi-lightbulb" ? "selected" : null)">Lighting</option>
                                <option value="bi-battery-full" selected="@(Model.category.Icon == "bi-battery-full" ? "selected" : null)">Battery</option>
                                <option value="bi-cpu" selected="@(Model.category.Icon == "bi-cpu" ? "selected" : null)">CPU</option>
                                <option value="bi-mouse" selected="@(Model.category.Icon == "bi-mouse" ? "selected" : null)">Mouse</option>
                                <option value="bi-keyboard" selected="@(Model.category.Icon == "bi-keyboard" ? "selected" : null)">Keyboard</option>
                                <option value="bi-tablet" selected="@(Model.category.Icon == "bi-tablet" ? "selected" : null)">Tablet</option>
                            </select>
                            <div id="iconPreview" style="font-size:2rem; margin-bottom:0.5rem;display:flex;justify-content:center;width:100%;height:100%;">
                                <i class="bi @(Model.category.Icon ?? "bi-question-circle")"></i>
                            </div>
                        </div>
                    </div>

                    <div class="toggle-row">
                        <label asp-for="category.ContainsConsumables">This category contains consumables that are not individually tracked</label>
                        <label class="switch">
                            @if (Model.category.ContainsConsumables)
                            {
                                <input type="checkbox" asp-for="category.ContainsConsumables" checked>
                                <span class="slider"></span>
                            }
                            else
                            {
                                <input type="checkbox" asp-for="category.ContainsConsumables">
                                <span class="slider"></span>
                            }
                        </label>
                    </div>

                    <div class="toggle-row">
                        <label>Update Asset Tags</label>
                        <label class="switch">
                            <input type="checkbox" asp-for="updateAssetTags">
                            <span class="slider"></span>
                        </label>
                    </div>

                    <input type="submit" value="Submit" asp-action="EditCategory" class="primary-btn">
                </form>
            }
        </div>
    </div>
</div>