@model TrackPoint.Views.Asset.AssetBrowserViewModel;
@using Microsoft.AspNetCore.Identity
@using System.Linq
@inject UserManager<IdentityUser> UserManager // TODO: Needed to get username of borrower, consider replacing this later so injection is not needed.

@{
    ViewData["Title"] = "Browse";
    var msg = TempData["Success"] as string; // TODO: This will always have the success conditional, add support for Failure (red) and Warning (yellow)
}

@if (!string.IsNullOrEmpty(msg))
{
    <div class="alert alert-success" role="alert">
        @msg
    </div>
}
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Inter+Tight:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
<head>
    <link rel="stylesheet" href="/css/table.css">
</head>

<style>
    .p-btn {
        width: 25%;
        margin-top: 28px;
        padding: 14px;
        font-size: 15px;
        font-weight: 600;
        text-align: center;
        color: #fff;
        background: #7c3aed;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: transform 0.15s, box-shadow 0.15s;
        text-decoration: none;
    }

    .s-btn {
        margin-top: 28px;
        padding: 14px;
        font-size: 15px;
        font-weight: 600;
        text-align: center;
        color: #fff;
        background: #4f46e5;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: transform 0.15s, box-shadow 0.15s;
        text-decoration: none;
    }

    /* DataTables top controls */
    #top-right {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .dataTables_filter,
    .dataTables_length {
        margin: 0;
    }

        .dataTables_filter label,
        .dataTables_length label {
            margin: 0;
            font-size: 14px;
            font-weight: 600;
            color: #475569;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .dataTables_filter input {
            width: 260px !important;
            padding: 12px 14px !important;
            border-radius: 8px !important;
            border: 1px solid #d1d5db !important;
            font-size: 14px !important;
            transition: border 0.2s, box-shadow 0.2s !important;
            background: #fff;
            margin-left: 0 !important;
        }

            .dataTables_filter input:focus {
                outline: none !important;
                border-color: #6366f1 !important;
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15) !important;
            }

        .dataTables_length select {
            width: auto !important;
            padding: 10px 12px !important;
            border-radius: 8px !important;
            border: 1px solid #d1d5db !important;
            font-size: 14px !important;
            background: #fff;
        }

        /* Optional: hide default "Search:" text if you want cleaner SaaS style */
        .dataTables_filter label {
            font-size: 0;
        }

        .dataTables_filter input::placeholder {
            color: #94a3b8;
            font-size: 14px;
        }

</style>


<div class="page">
    <div class="card">
        <h1>Browse Available Assets</h1>
        <div class="row" style="text-align:left;">
            <div class="col-md-3">
                <button class="secondary-btn" data-bs-toggle="modal" data-bs-target="#filterModal"><i class="bi bi-funnel fs-6"></i> Filter Data</button>
                @* customize table *@
                <button class="secondary-btn" data-bs-toggle="modal" data-bs-target="#columnToggleModal"><i class="bi bi-gear fs-6"></i> Customize</button>
                <!-- Column toggle Modal -->
                <div class="modal fade" id="columnToggleModal" tabindex="-1" aria-labelledby="columnToggleModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">

                            <!-- Modal Header -->
                            <div class="modal-header">
                                <h4 class="modal-title" id="columnToggleModalLabel">Select Columns to Display</h4>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <!-- Modal Body -->
                            <div class="modal-body d-flex flex-column align-items-center">
                                <div class="w-100" style="max-width: 300px;">

                                    <div class="toggle-row">
                                        <span>Asset Tag</span>
                                        <label class="switch">
                                            <input type="checkbox" class="toggle-vis" data-column="0" checked>
                                            <span class="slider"></span>
                                        </label>
                                    </div>

                                    <div class="toggle-row">
                                        <span>Make</span>
                                        <label class="switch">
                                            <input type="checkbox" class="toggle-vis" data-column="1" checked>
                                            <span class="slider"></span>
                                        </label>
                                    </div>

                                    <div class="toggle-row">
                                        <span>Model</span>
                                        <label class="switch">
                                            <input type="checkbox" class="toggle-vis" data-column="2" checked>
                                            <span class="slider"></span>
                                        </label>
                                    </div>

                                    <div class="toggle-row">
                                        <span>Category</span>
                                        <label class="switch">
                                            <input type="checkbox" class="toggle-vis" data-column="3" checked>
                                            <span class="slider"></span>
                                        </label>
                                    </div>

                                    <div class="toggle-row">
                                        <span>Location</span>
                                        <label class="switch">
                                            <input type="checkbox" class="toggle-vis" data-column="4" checked>
                                            <span class="slider"></span>
                                        </label>
                                    </div>

                                    <div class="toggle-row">
                                        <span>Issued To</span>
                                        <label class="switch">
                                            <input type="checkbox" class="toggle-vis" data-column="5" checked>
                                            <span class="slider"></span>
                                        </label>
                                    </div>

                                    <div class="toggle-row">
                                        <span>Status</span>
                                        <label class="switch">
                                            <input type="checkbox" class="toggle-vis" data-column="6" checked>
                                            <span class="slider"></span>
                                        </label>
                                    </div>

                                    <div class="toggle-row">
                                        <span>Notes</span>
                                        <label class="switch">
                                            <input type="checkbox" class="toggle-vis" data-column="7" checked>
                                            <span class="slider"></span>
                                        </label>
                                    </div>

                                </div>
                            </div>

                            <!-- Modal Footer -->
                            <div class="modal-footer">
                                <button type="button" class="p-btn" data-bs-dismiss="modal">Close</button>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Filter Modal (copied from customize modal and extended) -->
                <div class="modal fade" id="filterModal" tabindex="-1" aria-labelledby="filterModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">

                            <div class="modal-header">
                                <h4 class="modal-title" id="filterModalLabel">Filter Assets</h4>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <div class="modal-body">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="section-title">Asset Tag</label>
                                        <input id="filter-assetTag" class="form-control" placeholder="Exact or partial asset tag">
                                    </div>

                                    <div class="col-6">
                                        <label class="section-title">Make</label>
                                        <input id="filter-make" class="form-control" placeholder="Make">
                                    </div>

                                    <div class="col-6">
                                        <label class="section-title">Model</label>
                                        <input id="filter-model" class="form-control" placeholder="Model">
                                    </div>

                                    <div class="col-6">
                                        <label class="section-title">Category <i class="bi bi-info-circle" title="Hold control to select multiple"></i></label>
                                        <select id="filter-category" class="form-select" multiple>
                                            @foreach (var l in Model._categories ?? Enumerable.Empty<Category>())
                                            {
                                                <option value="@l.Name">@l.Name</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="col-6">
                                        <label class="section-title">Location <i class="bi bi-info-circle" title="Hold control to select multiple"></i></label>
                                        <select id="filter-location" class="form-select" multiple>
                                            @foreach (var l in Model._locations ?? Enumerable.Empty<Location>())
                                            {
                                                <option value="@l.Name">@l.Name</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="col-6">
                                        <label class="section-title">Issued To (username)</label>
                                        <input id="filter-issuedTo" class="form-control" placeholder="Username">
                                    </div>

                                    <div class="col-6">
                                        <label class="section-title">Status <i class="bi bi-info-circle" title="Hold control to select multiple"></i></label>
                                        <select id="filter-status" class="form-select" multiple>
                                            @{
                                                var statuses = (Model._assets ?? Enumerable.Empty<dynamic>())
                                                    .Select(a => (a.AssetStatus ?? "").ToString().Trim())
                                                    .Where(s => !string.IsNullOrWhiteSpace(s))
                                                    .Distinct();
                                            }
                                            @foreach (var s in statuses)
                                            {
                                                <option value="@s">@s</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="modal-footer">
                                <button type="button" id="clearFiltersBtn" class="p-btn">Clear Filters</button>
                                <button type="button" id="applyFiltersBtn" class="s-btn">Apply Filters</button>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
            <div class="col-md-3"></div>
            <div class="col-md-3"></div>
            <div class="col-md-3">
                <div class="d-flex justify-content-end mb-2" id="top-right">
                </div>
            </div>

        </div>

        <!-- Full-screen loading overlay to avoid layout shift while DataTables initializes -->
        <style>
            /* Loading overlay */
            #page-loading-overlay {
                position: fixed;
                inset: 0;
                background: rgba(255,255,255,0.95);
                z-index: 2000;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-direction: column;
                transition: opacity 0.35s ease;
            }

            #page-loading-overlay.hidden {
                opacity: 0;
                pointer-events: none;
            }

            .loader {
                width: 56px;
                height: 56px;
                border-radius: 50%;
                border: 6px solid #e6e6ee;
                border-top-color: #6b46c1; /* subtle purple */
                animation: spin 1s linear infinite;
                box-shadow: 0 6px 20px rgba(99,102,241,0.12);
                margin-bottom: 12px;
            }

            @@keyframes spin {
                to { transform: rotate(360deg); }
            }

            #page-loading-text {
                color: #374151;
                font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
                font-size: 14px;
                font-weight: 500;
                letter-spacing: 0.01em;
            }
        </style>

        <div id="page-loading-overlay" aria-hidden="true">
            <div class="loader" role="status" aria-hidden="true"></div>
            <div id="page-loading-text">Loading&hellip;</div>
        </div>

        <table class="table w-100" id="asset" style="display:none;">
            <thead>
                <tr>
                    <th>Asset Tag</th>
                    <th>Make</th>
                    <th>Model</th>
                    <th>Category</th>
                    <th>Location</th>
                    <th>Issued To</th>
                    <th>Status</th>
                    <th>Notes</th> <!-- TODO: This can become too long, either truncate, make it openable, or remove this. -->
                    <th>Actions</th> <!-- TODO: This is also sortable for no particular reason, figure out how to prevent sorting in DataTables. -->
                </tr>
            </thead>
            <tbody>
                @foreach (var asset in Model._assets)
                {
                    // Model.IssuedToUser.UserName currently does not work, so look up their username by their Id instead.
                    var issuedToName = "—";
                    if (!string.IsNullOrWhiteSpace(asset.IssuedToUser?.UserName))
                    {
                        issuedToName = asset.IssuedToUser.UserName;
                    }
                    else if (!string.IsNullOrWhiteSpace(asset.IssuedToUserId))
                    {
                        // Lookup user by Id in dbo.AspNetUsers
                        var user = UserManager.FindByIdAsync(asset.IssuedToUserId).GetAwaiter().GetResult();
                        issuedToName = user?.UserName ?? "Unassigned";
                    }
                    var categoryName = Model._categories?.FirstOrDefault(c => c.CategoryId == asset.CategoryId)?.Name ?? "-";
                    var locationName = Model._locations?.FirstOrDefault(c => c.LocationId == asset.LocationId)?.Name ?? "-";
                    var statusRaw = (asset.AssetStatus ?? "").ToString().Trim();
                    var statusKey = statusRaw.ToLowerInvariant();



                    var modalId = $"confirmModal-{asset.AssetId}";
                    var retireModalId = $"confirmRetireModal-{asset.AssetId}";
                    <tr>
                        <td>
                            <a asp-controller="Asset" asp-action="AssetView" asp-route-assetTag="@asset.AssetTag">@asset.AssetTag</a>
                        </td>
                        <td>@asset.Make</td>
                        <td>@asset.Model</td>
                        <td>@categoryName</td>
                        <td>@locationName</td>
                        <td>@issuedToName</td>
                        <td>@statusRaw</td>
                        <td>@asset.Notes</td>
                        <td class="actions-cell">
                            @* Borrow flow: Show button only when asset is available/in storage/transfered
                       Temporary change: Show the "Return" button if user currently borrows the asset.
                       TODO: Discuss if we want to keep this or relegate it to only the personal dashboard.
                            *@
                            @* Check Out *@
                            @if (statusKey == "instorage" || statusKey == "transfered" || statusKey == "transferred")
                            {
                                <button type="button"
                                        class="btn btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#@modalId"
                                        aria-label="Borrow asset"
                                        title="Borrow">
                                    <i class="bi bi-check-circle-fill fs-4"></i>
                                </button>

                                <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@($"{modalId}-label")" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="@($"{modalId}-label")">Borrow Asset</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to check out asset <strong>@asset.AssetTag</strong>?
                                                @* Show dialog if asset requires admin approval 
                                                   TODO: Individual assets may also require approval regardless of category
                                                *@
                                                @if (asset.Category.RequiresApproval)
                                                {
                                                    <br/><p><strong>Disclaimer:</strong> This asset requires admin approval to check out.</p>
                                                }
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <a asp-controller="Asset" asp-action="checkOut" asp-route-assetTag="@asset.AssetTag" class="btn btn-primary">Confirm</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (statusKey == "inuse" && asset.IssuedToUserId == UserManager.GetUserId(User))
                            {
                                <button type="button"
                                        class="btn btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#@modalId"
                                        aria-label="Return asset"
                                        title="Return">
                                    <i class="bi bi-check-circle fs-4"></i>
                                </button>

                                <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@($"{modalId}-label")" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="@($"{modalId}-label")">Return Asset</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to check the asset <strong>@asset.AssetTag</strong> back into the system?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <a asp-controller="Asset" asp-action="checkIn" asp-route-assetTag="@asset.AssetTag" class="btn btn-primary">Confirm</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm" aria-disabled="true"><i class="bi bi-check-circle fs-4"></i></button>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <a class="btn btn-sm"
                                   asp-controller="Asset"
                                   asp-action="AssetEdit"
                                   asp-route-AssetId="@asset.AssetId"
                                   aria-label="Edit asset"
                                   title="Edit">
                                    <i class="bi bi-pencil-fill fs-4"></i>
                                </a>

                                if(!asset.AssetStatus.Equals(Enums.AssetStatus.Retired.ToString()))
                                {
                                    <a class="btn btn-sm"
                                       data-bs-toggle="modal"
                                       data-bs-target="#@retireModalId"
                                       aria-label="Retire asset"
                                       title="Retire">
                                        <i class="bi bi-archive-fill fs-4"></i>
                                    </a>
                        
                                    <!--Confirmation modal adapted from Matthew's in the AssetBrowser-->
                                    <div class="modal fade" id="@retireModalId" tabindex="-1" aria-labelledby="@($"{retireModalId}-label")" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="@($"{retireModalId}-label")">Retire @asset.AssetTag</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Are you sure you want to retire this asset?<br /><strong>This asset will no longer be able to be borrowed.</strong><br /><br /><strong>Logs associated with this asset will remain.<br />This does not delete anything.</strong>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <a asp-controller="Asset" asp-action="RetireAsset" asp-route-assetId="@asset.AssetId" class="btn btn-danger">Retire</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                } else {
                                    <a class="btn btn-sm"
                                       data-bs-toggle="modal"
                                       data-bs-target="#@retireModalId"
                                       aria-label="Unretire asset"
                                       title="Unretire">
                                        <i class="bi bi-archive fs-4"></i>
                                    </a>

                                    <!--Confirmation modal adapted from Matthew's in the AssetBrowser-->
                                    <div class="modal fade" id="@retireModalId" tabindex="-1" aria-labelledby="@($"{retireModalId}-label")" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="@($"{retireModalId}-label")">Unretire @asset.AssetTag</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Are you sure you want to unretire this asset?<br><strong>This asset will be set to "In Storage", and will once again be borrowable.</strong>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <a asp-controller="Asset" asp-action="UnretireAsset" asp-route-assetId="@asset.AssetId" class="btn btn-danger">Unretire</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

<!-- DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.colresizable/1.6.0/colResizable-1.6.min.js"></script>
<script>
    $(window).on('load', function () {
    const table = $('#asset').DataTable({
    autoWidth: false,
    dom: 'fltp',
    pagingType: 'full_numbers',
    columnDefs: [
    {
    targets: 6,
    render: function (data) {
    const clean = (data || "").toString().trim().toLowerCase();

    const map = {
    "inuse": "red",
    "instorage": "green",
    "undermaintenance": "yellow",
    "pendingdeployment": "orange",
    "checkedout": "blue",
    "retired": "grey"
    };

    const slug = map[clean] || "blue";
    return `<span class="badge badge-${slug}">${data}</span>`;
    }
    }
    ],
    initComplete: function () {
    try {
    this.api().columns.adjust();
    } catch (e) {
    console.warn('columns.adjust() failed', e);
    }

    $('#top-right').append($('.dataTables_filter'));
    $('#top-right').append($('.dataTables_length'));

    $('.dataTables_filter input').attr('placeholder', 'Search assets');

    try {
    $('#page-loading-overlay').fadeOut(350, function () {
    $(this).addClass('hidden');
    });
    } catch (e) { }

    try {
    $('#asset').fadeIn(300);
    } catch (e) {
    $('#asset').css('display', '');
    }
    }
    });

    const columnModal = document.getElementById('columnToggleModal');
    if (columnModal) {
    columnModal.addEventListener('show.bs.modal', function () {
    document.querySelectorAll('input.toggle-vis').forEach((checkbox) => {
    const colIndex = Number(checkbox.getAttribute('data-column'));
    if (!Number.isNaN(colIndex) && table.column(colIndex) !== undefined) {
    checkbox.checked = table.column(colIndex).visible();
    }
    });
    });
    }

    document.querySelectorAll('input.toggle-vis').forEach((checkbox) => {
    checkbox.addEventListener('change', function (e) {
    const colIndex = Number(e.target.getAttribute('data-column'));
    if (!Number.isNaN(colIndex)) {
    const column = table.column(colIndex);
    column.visible(e.target.checked);
    }
    });
    });

    const filterModalEl = document.getElementById('filterModal');

    const filterMap = [
    { key: 'assetTag', index: 0, selector: '#filter-assetTag', multi: false },
    { key: 'make', index: 1, selector: '#filter-make', multi: false },
    { key: 'model', index: 2, selector: '#filter-model', multi: false },
    { key: 'category', index: 3, selector: '#filter-category', multi: true },
    { key: 'location', index: 4, selector: '#filter-location', multi: true },
    { key: 'issuedTo', index: 5, selector: '#filter-issuedTo', multi: false },
    { key: 'status', index: 6, selector: '#filter-status', multi: true }
    ];

    function escapeRegex(value) {
    return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function buildSearchPattern(values, isMulti) {
    if (isMulti) {
    if (!values || values.length === 0) return '';
    return '^(' + values.map(v => escapeRegex(v)).join('|') + ')$';
    }
    return values || '';
    }

    function getFilterValue(filter) {
    return $(filter.selector).val();
    }

    function setFilterValue(filter, value) {
    if (filter.multi) {
    if (!value) {
    $(filter.selector).val([]);
    } else {
    $(filter.selector).val(value.split(','));
    }
    } else {
    $(filter.selector).val(value || '');
    }
    }

    function applyFilterToColumn(filter) {
    const value = getFilterValue(filter);
    const searchPattern = buildSearchPattern(value, filter.multi);

    if (filter.multi) {
    table.column(filter.index).search(searchPattern, true, false);
    } else {
    table.column(filter.index).search(searchPattern, false, false);
    }
    }

    function applyFiltersFromUrl() {
    const params = new URLSearchParams(window.location.search);
    let any = false;

    filterMap.forEach(f => {
    const value = params.get(f.key) || '';
    setFilterValue(f, value);
    applyFilterToColumn(f);

    if (value) any = true;
    });

    if (any) {
    table.draw();
    }
    }

    function updateUrlWithFilters() {
    const params = new URLSearchParams(window.location.search);

    filterMap.forEach(f => {
    const value = getFilterValue(f);

    if (f.multi) {
    if (value && value.length > 0) {
    params.set(f.key, value.join(','));
    } else {
    params.delete(f.key);
    }
    } else {
    if (value) {
    params.set(f.key, value);
    } else {
    params.delete(f.key);
    }
    }
    });

    const newUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
    history.replaceState(null, '', newUrl);
    }

    if (filterModalEl) {
    filterModalEl.addEventListener('show.bs.modal', function () {
    const params = new URLSearchParams(window.location.search);

    filterMap.forEach(f => {
    const value = params.get(f.key) || '';
    setFilterValue(f, value);
    });
    });
    }

    applyFiltersFromUrl();

    $('#applyFiltersBtn').on('click', function () {
    filterMap.forEach(f => {
    applyFilterToColumn(f);
    });

    table.draw();
    updateUrlWithFilters();

    try {
    const modalInstance = bootstrap.Modal.getInstance(filterModalEl);
    if (modalInstance) modalInstance.hide();
    } catch (e) { }
    });

    $('#clearFiltersBtn').on('click', function () {
    filterMap.forEach(f => {
    if (f.multi) {
    $(f.selector).val([]);
    } else {
    $(f.selector).val('');
    }

    if (f.multi) {
    table.column(f.index).search('', true, false);
    } else {
    table.column(f.index).search('', false, false);
    }
    });

    table.draw();

    const params = new URLSearchParams(window.location.search);
    filterMap.forEach(f => params.delete(f.key));
    const newUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
    history.replaceState(null, '', newUrl);
    });
    });
</script>