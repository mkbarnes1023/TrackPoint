@model TrackPoint.Models.ReportRequestViewModel

@{
    ViewData["Title"] = "Report Builder";
}

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<head>
    <link rel="stylesheet" href="/css/form.css">
</head>

<div class="page">
    <div class="card">
        <h1>Generate a Report</h1>

        <form asp-action="ReportBuilder" asp-controller="Report" method="post">
            <div class="field">
                <div class="section-title">Report Type</div>
                <select asp-for="ReportType">
                    <option value="">Please select one</option>
                    <option value="Category">Category Report</option>
                    <option value="Location">Location Report</option>
                    <option value="Status">Status Report</option>
                </select>
                <span asp-validation-for="ReportType" class="validation"></span>
            </div>

            <div class="section-title">Include in Report</div>

            <div class="toggle-row">
                <span>Generate KPI Summary Page</span>
                <label class="switch">
                    <input asp-for="Visualization" type="checkbox" />
                    <span class="slider"></span>
                </label>
            </div>

            <div class="toggle-row">
                <span>Generate Table Summary</span>
                <label class="switch">
                    <input asp-for="Table" type="checkbox" />
                    <span class="slider"></span>
                </label>
            </div>

            <div class="field">
                <div class="section-title">Export Type</div>
                <select asp-for="ExportType">
                    <option value="">Please select one</option>
                    <option value="Excel">Excel</option>
                    <option value="PDF">PDF</option>
                </select>
                <span asp-validation-for="ExportType" class="validation"></span>
            </div>

            <button type="submit" class="primary-btn">
                Generate Report
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}