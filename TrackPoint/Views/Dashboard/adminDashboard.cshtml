@model TrackPoint.Models.DTOs.AdminDashboardViewModel
@using System.Text.Json
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@inject TrackPoint.Data.ApplicationDbContext Db

@{
    ViewData["Title"] = "Admin Dashboard";
    var msg = TempData["Success"] as string;
}

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Inter+Tight:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

<head>
    <link rel="stylesheet" href="/css/dashboard.css">
</head>
<style>
    .primary-btn {
        width: 25%;
        height: 50px;
        display: inline-flex !important;
        font-size: 15px;
        font-weight: 600;
        text-align: center;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: transform 0.15s, box-shadow 0.15s;
        text-decoration: none;
    }

    .primary-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 20px rgba(79, 70, 229, 0.35);
    }
</style>


<div class="page">
    <div class="row g-1" style="justify-content: right;">
        <div class="col-md-6 text-right">
            <a asp-controller="Report" asp-action="ReportBuilder" class="primary-btn">
                <i class="bi bi-info-file-earmark-bar-graph fs-4"></i>Report
            </a>
        </div>
    </div>

    <!-- Priority Overview -->
    <div class="section">
        <h4>Priority Overview</h4>
        <div class="d-flex flex-wrap">
            <div class="priority-card priority-needs-attention">
                <div class="priority-number">
                    <a style="text-decoration: none; color: #be185d" asp-controller="Asset" asp-action="Attention">@Model.NeedsAttention</a>
                </div>
                <div class="priority-label">Needs Attention</div>
            </div>

            <div class="priority-card priority-overdue">
                <div class="priority-number">
                    <a style="text-decoration: none; color:#7c3aed;" asp-controller="Asset" asp-action="Overdue">@Model.Overdue</a>
                </div>
                <div class="priority-label">Overdue</div>
            </div>

            <div class="priority-card priority-warranty-expiring">
                <div class="priority-number">
                    <a style="text-decoration: none;" asp-controller="Asset" asp-action="ExpiringSoon">@Model.ExpiringSoonCount</a>
                </div>
                <div class="priority-label">Warranty Expiring</div>
            </div>

            <div class="priority-card priority-unassigned">
                <div class="priority-number">
                    <a style="text-decoration: none;" asp-controller="Asset" asp-action="Unassigned">@Model.UnassignedCount</a>
                </div>
                <div class="priority-label">Unassigned</div>
            </div>
        </div>
    </div>

    <!-- System Overview -->
    <div class="section">
        <h4>System Overview</h4>
        <div class="d-flex flex-wrap">
            <div class="chart-container">
                <div class="chart-title">Asset by Status</div>
                <div class="chart-canvas-wrapper">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>

            <div class="chart-container">
                <div class="chart-title">Warranty Coverage</div>
                <div class="chart-canvas-wrapper">
                    <canvas id="warranty"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Center -->
    <div class="section">
        <h4>Action Center</h4>

        <div class="d-flex flex-column" style="gap: 20px; margin-top: 15px;">
            <div class="section">
                <div style="display:flex; justify-content: space-between; align-items:center; margin-bottom: 16px;">
                    <h4 class="chart-title">Needs Immediate Action</h4>
                </div>
                <!-- Needs Immediate Action Table -->
                <div class="table-container">
                    <table class="table" id="action">
                        <thead>
                            <tr>
                                <th>Asset Tag</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Attention.Any())
                            {
                                int count = 0;

                                foreach (var asset in Model.Attention)
                                {
                                    if (count == 5) { break; }

                                    <tr>
                                        <td>@asset.AssetTag</td>
                                        <td>@(Db.Category.FirstOrDefault(c => c.CategoryId == asset.CategoryId)?.Name ?? "")</td>
                                        <td>@asset.AssetStatus</td>
                                        <td style="text-align: center;">
                                            <a class="btn btn-sm"
                                               asp-controller="Asset"
                                               asp-action="AssetView"
                                               asp-route-assetTag="@asset.AssetTag"
                                               title="View details">
                                                <i class="bi bi-info-circle-fill"></i>
                                            </a>
                                        </td>
                                    </tr>

                                    count++;
                                }

                                @* show "view more" if there are more than 5 *@
                                @if (Model.Attention.Count() > 5)
                                {
                                    <tr>
                                        <td colspan="4" style="text-align:center;">
                                            <a asp-controller="Asset"
                                               asp-action="Attention"
                                               
                                               style="color:#2563eb; font-weight:500;">
                                                View all assets requiring attention 
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" style="text-align:center; font-style:italic; color:#6b7280;">
                                        
                                        Nothing to display
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="section">
                <div style="display:flex; justify-content: space-between; align-items:center; margin-bottom: 16px;">
                    <h4 class="chart-title">Pending Approvals</h4>
                </div>
                <div class="table-container">
                    <table class="table" id="action">
                        <thead>
                            <tr>
                                <th>Asset Tag</th>
                                <th>Approval Reason</th>
                                <th>Requestor</th>
                                <th>Request Date</th>
                                <th style="text-align:right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model._approvals.Any())
                            {
                                foreach (var approval in Model._approvals)
                                {
                                    <tr>
                                        <td>@(approval.Asset?.AssetTag ?? approval.AssetId.ToString())</td>
                                        <td>@(approval.ApprovalReason?.ReasonName ?? "—")</td>
                                        <td>@UserManager.Users.FirstOrDefault(u => u.Id == approval.RequestorId)?.UserName</td>
                                        <td>@approval.RequestDate</td>
                                        <td style="text-align:right;">
                                            <!-- Approve Button -->
                                            <a class="btn btn-success btn-sm me-2" data-bs-toggle="modal" data-bs-target="#approveModal-@approval.ApprovalId">Approve</a>
                                            <!-- Deny Button -->
                                            <a class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#denyModal-@approval.ApprovalId">Deny</a>
                                        </td>
                                    </tr>
                                    <!-- Approve Modal -->
                                    <div class="modal fade" id="approveModal-@approval.ApprovalId" tabindex="-1" aria-labelledby="approveModalLabel-@approval.ApprovalId" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="approveModalLabel-@approval.ApprovalId">Confirm Approve</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Are you sure you want to approve this asset?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <a class="btn btn-success" href="@Url.Action("ApproveAsset", "Approvals", new { ApprovalId = approval.ApprovalId })">Approve</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Deny Modal -->
                                    <div class="modal fade" id="denyModal-@approval.ApprovalId" tabindex="-1" aria-labelledby="denyModalLabel-@approval.ApprovalId" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <form method="post" action="@Url.Action("RejectAsset", "Approvals")">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="denyModalLabel-@approval.ApprovalId">Confirm Deny</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <input type="hidden" name="ApprovalId" value="@approval.ApprovalId" />
                                                        <label for="denyReason-@approval.ApprovalId" class="form-label">Are you sure you want to deny this asset?<br>If so, please state a reason for denying the approval:</label>
                                                        <textarea id="denyReason-@approval.ApprovalId" name="DenyReason" class="form-control" maxlength="256" required style="resize:none;"></textarea>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-danger">Deny</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" style="text-align:center; font-style:italic; color:#6b7280;">
                                        <i class="bi bi-robot fs-4"></i><br />
                                        Nothing to display
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        DrawAssetChart();
        DrawWarrantyChart();

        function DrawAssetChart() {
            const labels = @Html.Raw(JsonSerializer.Serialize(Model.StatusCounts.Select(s => s.Label)));
            const data = @Html.Raw(JsonSerializer.Serialize(Model.StatusCounts.Select(s => s.Count)));

            const ctx = document.getElementById('statusChart').getContext('2d');

            const backgroundColors = [
                '#14b8a6',
                '#7c3aed',
                '#3b82f6',
                '#6366f1',
                '#9333ea',
                '#f472b6',
                '#facc15',
                '#ec4899'
            ];

            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: backgroundColors.slice(0, data.length),
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    aspectRatio: 1,
                    cutout: '65%', // safe + modern
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                boxWidth: 10,
                                padding: 14,
                                color: '#374151',
                                font: {
                                    size: 13
                                }
                            }
                        },
                        tooltip: {
                            backgroundColor: '#111827',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            padding: 10,
                            cornerRadius: 6
                        }
                    }
                }
            });
        }

        function DrawWarrantyChart() {
            const expired = @Html.Raw(JsonSerializer.Serialize(Model.ExpiredCount));
            const zeroToThirty = @Html.Raw(JsonSerializer.Serialize(Model.ZeroToThirty));
            const thirtyOneToNinety = @Html.Raw(JsonSerializer.Serialize(Model.ThirtyOneToNinety));
            const ninetyPlus = @Html.Raw(JsonSerializer.Serialize(Model.NinetyPlus));
            const totalAssets = @Html.Raw(JsonSerializer.Serialize(Model.StatusCounts.Sum(s => s.Count)));
            const noWarranty = Math.max(0, totalAssets - (expired + zeroToThirty + thirtyOneToNinety + ninetyPlus));

            const labels = ['No Warranty', 'Expired', '0-30 days', '31-90 days', '90+ days'];
            const data = [noWarranty, expired, zeroToThirty, thirtyOneToNinety, ninetyPlus];

            const ctx = document.getElementById('warranty').getContext('2d');

            const backgroundColors = [
                '#c4b5fd',
                '#7c3aed',
                '#9333ea',
                '#14b8a6',
                '#f472b6'
            ];

            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: backgroundColors,
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    aspectRatio: 1,
                    cutout: '65%',
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                boxWidth: 10,
                                padding: 14,
                                color: '#374151',
                                font: {
                                    size: 13
                                }
                            }
                        },
                        tooltip: {
                            backgroundColor: '#111827',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            padding: 10,
                            cornerRadius: 6
                        }
                    }
                }
            });
        }
    </script>
