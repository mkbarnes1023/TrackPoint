@using System.Linq
@using System.Text.Json
@model TrackPoint.Models.DTOs.BorrowerDashboardViewModel
@inject TrackPoint.Data.ApplicationDbContext Db
@inject Microsoft.AspNetCore.Identity.UserManager<Microsoft.AspNetCore.Identity.IdentityUser> UserManager

@{
    ViewData["Title"] = "Dashboard";
    bool isAdmin = User.IsInRole("Admin");

    var currentUserId = UserManager.GetUserId(User);
    var assetsForUser = Db.Asset
        .Where(a => a.IssuedToUserId == currentUserId)
        .ToList();

    var myAssets = assetsForUser
        .Select(a => new {
            a.AssetId,
            a.AssetTag,
            Category = Db.Category.FirstOrDefault(c => c.CategoryId == a.CategoryId)?.Name ?? "",
            DueDate = (DateTime?)null
        })
        .ToList();
}
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Inter+Tight:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

<head>
    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<div class="page">
    <!-- Page Header -->
    <div class="row g-1">
        <div class="col-md-6">
            <h1>Home</h1>
        </div>
    </div>

    <!-- Priority Overview -->
    <div class="section">
        <h4>Priority Overview</h4>
        <div class="d-flex flex-wrap">
            <div class="priority-card priority-needs-attention">
                <div class="priority-number">@Model.AssignedToUser</div>
                <div class="priority-label">My Assets</div>
            </div>

            <div class="priority-card priority-overdue">
                <div class="priority-number">0</div>
                <div class="priority-label">Action Required</div>
            </div>

            <div class="priority-card priority-warranty-expiring">
                <div class="priority-number">0</div>
                <div class="priority-label">Expiring Soon</div>
            </div>
        </div>
    </div>

    <!-- Action Center -->
    <div class="section">
        <h4>Action Center</h4>
        <div class="d-flex flex-column" style="gap: 20px; margin-top: 15px;">

            <!-- My Assets Table -->
            <div class="section">
                <h6>My Assets</h6>
                <div class="table-container">
                    <table class="table w-100" id="assignedAssets">
                        <thead>
                            <tr>
                                <th>Asset Tag</th>
                                <th>Category</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Assigned.Any())
                            {
                                foreach (var asset in Model.Assigned)
                                {
                                    <tr>
                                        <td>@asset.AssetTag</td>
                                        <td>@asset.CategoryId</td>
                                        <td>
                                            <a class="btn btn-sm"
                                               asp-controller="Asset"
                                               asp-action="AssetView"
                                               asp-route-assetTag="@asset.AssetTag"
                                               title="View details">
                                                <i class="bi bi-info-circle-fill"></i>
                                            </a>
                                            <a class="btn btn-sm"
                                               asp-controller="Asset"
                                               asp-action="checkIn"
                                               asp-route-assetTag="@asset.AssetTag"
                                               title="Check In">
                                                <i class="bi bi-check-circle"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center" style="font-style:italic; color:#6b7280;">
                                        Nothing to display
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Alerts Table -->
            <div class="section">
                <h6>Alerts</h6>
                <div class="table-container">
                    <table class="table" id="alerts">
                        <thead>
                            <tr>
                                <th>Asset Tag</th>
                                <th>Approval Reason</th>
                                <th>Request Date</th>
                                <th>Approval Status</th>
                                <th style="text-align:right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var currUserId = UserManager?.GetUserId(User) ?? ""; // fallback empty string if UserManager is null
                                var userApprovals = new List<Approvals>();

                                if (Model != null && Model._approvals != null)
                                {
                                    userApprovals = Model._approvals
                                    .Where(a => a.RequestorId == currUserId)
                                    .ToList();
                                }
                            }

                            @if (userApprovals.Any())
                            {
                                foreach (var approval in userApprovals)
                                {
                                    <tr>
                                        <td>@approval.AssetId</td>
                                        <td>@approval.ApprovalReason</td>
                                        <td>@approval.RequestDate</td>
                                        <td>@approval.ApprovalStatus</td>
                                        <td style="text-align:right;">
                                            <a asp-controller="Approvals" asp-action="ApproveAsset" asp-route-ApprovalId="@approval.ApprovalId"
                                               class="btn btn-success btn-sm me-2">Approve</a>
                                            <a asp-controller="Approvals" asp-action="RejectAsset" asp-route-ApprovalId="@approval.ApprovalId"
                                               class="btn btn-light btn-sm">Deny</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" style="text-align:center; font-style:italic; color:#6b7280;">
                                        Nothing to display
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>
   




