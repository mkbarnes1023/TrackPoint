@using System.Linq
@using System.Text.Json
@model TrackPoint.Models.DTOs.BorrowerDashboardViewModel
@inject TrackPoint.Data.ApplicationDbContext Db
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Home";
    bool isAdmin = User.IsInRole("Admin");

    var currentUserId = UserManager.Users.FirstOrDefault(u => u.UserName == User.Identity.Name)?.Id;

    var assetsForUser = Db.Asset
        .Where(a => a.IssuedToUserId == currentUserId)
        .ToList();

    var myAssets = assetsForUser
        .Select(a => new
        {
            a.AssetId,
            a.AssetTag,
            Category = Db.Category.FirstOrDefault(c => c.CategoryId == a.CategoryId)?.Name ?? "",
            DueDate = (DateTime?)null
        })
        .ToList();
}
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Inter+Tight:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

<head>
    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<div class="page">
    <div class="section">
        <h4>Priority Overview</h4>
        <div class="d-flex flex-wrap">
            <div class="priority-card priority-needs-attention">
                <div class="priority-number">
                    <a style="text-decoration: none; color: #be185d" asp-controller="Asset" asp-action="AssetBrowser" asp-route-issuedTo="@User.Identity.Name">@Model.AssignedToUser</a>
                </div>
                <div class="priority-label">My Assets</div>
            </div>

            <div class="priority-card priority-overdue">
                <div class="priority-number">
                    <a style="text-decoration: none; color:#7c3aed;" asp-controller="Asset" asp-action="AssetBrowser" asp-route-issuedTo="@User.Identity.Name"  asp-route-loan="due-3">@Model.DueSoon</a>
                </div>
                <div class="priority-label">Due Soon</div>
            </div>

            <div class="priority-card priority-warranty-expiring">
                <div class="priority-number">
                        <a style="text-decoration: none;" asp-controller="Asset" asp-action="AssetBrowser" asp-route-issuedTo="@User.Identity.Name" asp-route-warranty="0-30">@Model.WarrantyExpiringSoon</a>
                    </div>
                <div class="priority-label">Warranty Expiring</div>
            </div>
        </div>
    </div>

    <div class="section">
        <h4>Action Center</h4>
        <div class="d-flex flex-column" style="gap: 20px; margin-top: 15px;">

            <div class="section">
                <h6>My Assets</h6>
                <div class="table-container">
                    <table class="table w-100" id="assignedAssets">
                        <thead>
                            <tr>
                                <th>Asset Tag</th>
                                <th>Category</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Assigned.Any())
                            {
                                int count = 0;

                                foreach (var asset in Model.Assigned)
                                {
                                    if (count == 5) { break; }

                                    <tr>
                                        <td>@asset.AssetTag</td>
                                        <td>@(Db.Category.FirstOrDefault(c => c.CategoryId == asset.CategoryId)?.Name ?? "")</td>
                                        <td>
                                            <a class="btn btn-sm"
                                               asp-controller="Asset"
                                               asp-action="AssetView"
                                               asp-route-assetTag="@asset.AssetTag"
                                               title="View details">
                                                <i class="bi bi-info-circle-fill"></i>
                                            </a>
                                            <a class="btn btn-sm"
                                               asp-controller="Asset"
                                               asp-action="checkIn"
                                               asp-route-assetTag="@asset.AssetTag"
                                               title="Check In">
                                                <i class="bi bi-check-circle"></i>
                                            </a>
                                        </td>
                                    </tr>

                                    count++;
                                }

                                @* show "view more" if more than 5 *@
                                @if (Model.Assigned.Count() > 5)
                                {
                                    <tr>
                                        <td colspan="3" style="text-align:center;">
                                            <a asp-controller="Asset" asp-action="AssetBrowser" asp-route-issuedTo="@User.Identity.Name">View Your Assets</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center" style="font-style:italic; color:#6b7280;">
                                        <i class="bi bi-robot fs-4"></i><br />
                                        Nothing to display
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="section">
                <h6>Alerts</h6>
                <div class="table-container">
                    <table class="table" id="alerts">
                        <thead>
                            <tr>
                                <th>Asset Tag</th>
                                <th>Approval Reason</th>
                                <th>Request Date</th>
                                <th>Approval Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var userApprovals = Model?._approvals?.ToList() ?? new List<TrackPoint.Models.Approvals>();
                            }

                            @if (userApprovals.Any())
                            {
                                foreach (var approval in userApprovals)
                                {
                                    <tr>
                                        <td>@(approval.Asset?.AssetTag ?? approval.AssetId.ToString())</td>
                                        <td>@(approval.ApprovalReason?.ReasonName ?? "—")</td>
                                        <td>@approval.RequestDate.ToString("g")</td>
                                        <td>@approval.ApprovalStatus</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" style="text-align:center; font-style:italic; color:#6b7280;">
                                        Nothing to display
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>